<?xml version="1.0" encoding="utf-8"?>
<!--
    Regras de extração de dados (Android 12+).
    - cloud-backup: backup na conta Google do usuário.
    - device-transfer: migração para um aparelho novo.

    Nos dois casos o banco local é incluído: perder o histórico ao trocar de
    celular seria a pior falha possível para um app de controle financeiro.

    ⚠️ O `-wal` acompanha o `.db` obrigatoriamente — ver o comentário em
    `backup_rules.xml`. Sem ele, o que se restaura é um banco quase vazio que se
    apresenta como íntegro.
-->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="database"
            path="driverpro.db" />
        <include
            domain="database"
            path="driverpro.db-wal" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="database"
            path="driverpro.db" />
        <include
            domain="database"
            path="driverpro.db-wal" />
    </device-transfer>
</data-extraction-rules>
